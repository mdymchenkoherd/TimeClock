<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Edit Timecards</title>

  <!-- DatePicker (Flatpickr) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  <style>
    table {
      width: 80%;
      margin: 20px auto;
      border-collapse: collapse;
    }
    th, td {
      padding: 10px;
      border: 1px solid #ccc;
      text-align: center;
    }
    input[type="text"],
    input[type="datetime-local"] {
      width: 100%;
      box-sizing: border-box;
    }
    button {
      padding: 6px 12px;
      cursor: pointer;
    }
    form.filter-form {
      text-align: center;
      margin-bottom: 20px;
    }
    .top-bar {
      width: 80%;
      margin: 20px auto;
      text-align: center;
      font-family: Arial, sans-serif;
      font-size: 16px;
    }
    .top-bar a {
      margin: 0 10px;
      text-decoration: none;
      color: #007bff;
    }
    .top-bar a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

  <!-- Top Bar -->
  <div class="top-bar">
    Welcome, <strong><%= user.username %></strong>
    <% if (user.role === 'admin') { %>
      | <a href="/history">View Login History</a>
    <% } %>
    | <a href="/logout">Logout</a>
  </div>

  <!-- Filter Form -->
  <form method="GET" class="filter-form">
    <label>
      From:
      <input
        type="text"
        id="fromDate"
        name="from"
        value="<%= filterFrom %>"
        autocomplete="off"
      >
    </label>
    &nbsp;
    <label>
      To:
      <input
        type="text"
        id="toDate"
        name="to"
        value="<%= filterTo %>"
        autocomplete="off"
      >
    </label>
    &nbsp;
    <label>
      Employee:
      <input
        type="text"
        name="name"
        placeholder="Search name"
        value="<%= name || '' %>"
      >
    </label>
    &nbsp;

    <button type="submit">Apply Filter</button>
    <button type="submit" formaction="/export">Export</button>
  </form>

  <!-- Timecards Table -->
  <table>
    <thead>
      <tr>
        <th>Employee</th>
        <th>Start Time</th>
        <th>End Time</th>
        <th>Update</th>
      </tr>
    </thead>
    <tbody>
      <% timecards.forEach(tc => { %>
        <tr>
          <form method="POST" action="/update/<%= tc.lmpTimecardID %>">
            <td><%= tc.lmeEmployeeName %></td>
            <td>
              <input
                type="datetime-local"
                name="startTime"
                value="<%= new Date(tc.lmpActualStartTime).toISOString().slice(0,16) %>"
                required
              >
            </td>
            <td>
              <input
                type="datetime-local"
                name="endTime"
                value="<%= tc.lmpActualEndTime ? new Date(tc.lmpActualEndTime).toISOString().slice(0,16) : '' %>"
              >
            </td>
            <td>
              <button type="submit">Save</button>
            </td>
          </form>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <!-- DatePicker Init -->
  <script>
    flatpickr("#fromDate", {
      dateFormat: "Y-m-d",
      allowInput: true
    });

    flatpickr("#toDate", {
      dateFormat: "Y-m-d",
      allowInput: true
    });
  </script>

</body>
</html>
